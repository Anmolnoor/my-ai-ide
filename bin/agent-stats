#!/usr/bin/env bash
# agent-stats: what my agents did in the last 24 hours and 7 days, and how the machine is doing.
#   agent-stats              print tables for this machine
#   agent-stats --with HOST  also run it on HOST over ssh and show both
#   agent-stats --json       print one JSON line per machine (for a daily log)
#   agent-stats --days N     print one JSON line per machine per local day, last N days, today included
# Sessions are transcript files written to inside the window (with --days:
# files with a model call that day). Hours count 5-minute slots with a model
# call: active hours once per slot, agent hours once per session per slot. PR
# counts come from GitHub, so they cover every machine; the rest covers the
# machine it runs on.
set -euo pipefail

C="$HOME/.claude/projects" X="$HOME/.codex/sessions" DAY=1440 WEEK=10080
OS=$(uname -s)

# Transcript files written to in the last $2 minutes under dir $1; extra find args follow.
files() { [ -d "$1" ] || return 0; find "$1" -name '*.jsonl' -mmin -"$2" "${@:3}"; }
prs() { gh search prs --author=@me --limit 1000 --json number -q length "$@"; }
ago() { jq -nr --argjson m "$1" 'now - $m * 60 | todate'; }

# One line per model call in the last $1 minutes (Claude replies, Codex turns), tagged with its file.
events() {
  files "$C" "$1" -exec env LC_ALL=C awk 'index($0, "\"usage\"") {print FILENAME "\t" $0}' {} + &&
  files "$X" "$1" -exec env LC_ALL=C awk 'index($0, "\"token_count\"") {print FILENAME "\t" $0}' {} +
}
# jq: one tagged line -> {f, ts, id, out, in, cr} for Claude or {f, ts, id, codex} for Codex.
CALLS='index("\t") as $i | .[:$i] as $f | .[$i + 1:] | fromjson |
  if .type == "assistant" and .message.usage then .message.usage as $u |
    # One API reply is logged once per content block: key it by message.id.
    {f: $f, ts: .timestamp, id: (.message.id // "\($f) \(.timestamp)"), out: ($u.output_tokens // 0),
     in: (($u.input_tokens // 0) + ($u.cache_creation_input_tokens // 0)), cr: ($u.cache_read_input_tokens // 0)}
  elif .payload.type == "token_count" and .payload.info then
    # Codex logs a running total per turn, sometimes twice: key it by that total.
    {f: $f, ts: .timestamp, id: "\($f) \(.payload.info.total_token_usage.total_tokens)",
     codex: .payload.info.last_token_usage.total_tokens}
  else empty end'
# jq: a list of calls -> tokens and hours.
STATS='def hours: length / 12 * 10 | round / 10;
  def stats: unique_by(.id) | map(.slot = (.ts[:19] + "Z" | fromdate / 300 | floor)) |
    map(select(.codex == null)) as $c | {
      output_tokens: ($c | map(.out) | add // 0), input_tokens: ($c | map(.in) | add // 0),
      cache_read_tokens: ($c | map(.cr) | add // 0), codex_tokens: (map(.codex // 0) | add // 0),
      active_hours: (map(.slot) | unique | hours), agent_hours: (map([.f, .slot]) | unique | hours)}
    | .total_tokens = .output_tokens + .input_tokens + .cache_read_tokens + .codex_tokens;'

# Tokens and hours for both windows, from one scan.
usage() {
  set -e   # bash turns errexit off inside $(...); a failed step must not print partial totals
  events $WEEK | jq -Rc "$CALLS" |
  jq -s --arg d "$(ago $DAY)" --arg w "$(ago $WEEK)" "$STATS"'
    {"24h": (map(select(.ts >= $d)) | stats), "7d": (map(select(.ts >= $w)) | stats)}'
}

# Crashes, OOM kills and system errors in the last $1 minutes, one JSON line {k, t} each.
health_events() {
  set -e
  local min=$1 since d
  if [ "$OS" = Darwin ]; then
    # The unified log has millions of error lines a day; crash and Jetsam reports are the signal.
    for d in /Library/Logs/DiagnosticReports "$HOME/Library/Logs/DiagnosticReports"; do
      if [ -d "$d" ]; then find "$d" -maxdepth 1 -name '*.ips' -mmin -"$min" -exec stat -f '%m %N' {} +; fi
    done | awk '{print "{\"k\":\"" ($0 ~ /\/JetsamEvent[^\/]*$/ ? "oom" : "crash") "\",\"t\":" $1 "}"}'
  else
    since="@$(jq -n --argjson m "$min" 'now - $m * 60 | floor')"
    journalctl -q -o short-unix --since "$since" MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1 |
      awk '/^[0-9]/ {print "{\"k\":\"crash\",\"t\":" int($1) "}"}'
    journalctl -q -o short-unix --since "$since" _TRANSPORT=kernel + _SYSTEMD_UNIT=systemd-oomd.service |
      awk '/^[0-9]/ && /Killed process|Killed .* due to/ {print "{\"k\":\"oom\",\"t\":" int($1) "}"}'
    journalctl -q -o short-unix -p err --since "$since" | awk '/^[0-9]/ {print "{\"k\":\"error\",\"t\":" int($1) "}"}'
  fi
}
# jq: a list of health events -> counts (no system errors on macOS).
HEALTH='def health($os): {crashes: map(select(.k == "crash")) | length, oom_kills: map(select(.k == "oom")) | length,
  system_errors: (if $os == "Darwin" then null else map(select(.k == "error")) | length end)};'

# Counts that take one command per window.
window() {
  set -e
  local min=$1 since sessions subagents codex opened merged h
  since=$(ago "$min")
  sessions=$(files "$C" "$min" ! -path '*/subagents/*' | wc -l)
  subagents=$(files "$C" "$min" -path '*/subagents/*' | wc -l)
  codex=$(files "$X" "$min" | wc -l)
  opened=$(prs --created=">=$since")
  merged=$(prs --merged-at=">=$since")
  h=$(health_events "$min" | jq -sc --arg os "$OS" "$HEALTH"'health($os)')
  jq -n --argjson h "$h" '{prs_opened: $ARGS.positional[0], prs_merged: $ARGS.positional[1],
    claude_sessions: $ARGS.positional[2], claude_subagents: $ARGS.positional[3],
    codex_sessions: $ARGS.positional[4]} + $h' --jsonargs "$opened" "$merged" "$sessions" "$subagents" "$codex"
}

machine() {
  set -e
  local os cpus mem used up load page boot now
  if [ "$OS" = Darwin ]; then
    os="macOS $(sw_vers -productVersion)"; cpus=$(sysctl -n hw.ncpu); mem=$(sysctl -n hw.memsize); page=$(sysctl -n hw.pagesize)
    used=$(vm_stat | awk -v p="$page" '/Pages active|Pages wired|occupied by compressor/ {n += $NF} END {print n * p}')
    boot=$(sysctl -n kern.boottime | sed 's/^{ sec = \([0-9]*\).*/\1/'); now=$(date +%s); up=$((now - boot))
    load=$(sysctl -n vm.loadavg | awk '{print $2}')
  else
    os=$(. /etc/os-release && echo "$PRETTY_NAME"); cpus=$(nproc)
    read -r mem used < <(awk '/^MemTotal/ {t = $2} /^MemAvailable/ {a = $2} END {print t * 1024, (t - a) * 1024}' /proc/meminfo)
    up=$(cut -d' ' -f1 /proc/uptime); load=$(cut -d' ' -f1 /proc/loadavg)
  fi
  jq -n --arg os "$os" '$ARGS.positional as [$cpus, $load, $up, $mem, $used, $free] |
    def gb: . / 1073741824 * 10 | round / 10;
    {os: $os, cpus: $cpus, load_1m: $load, uptime_hours: ($up / 360 | round / 10),
     mem_used_gb: ($used | gb), mem_total_gb: ($mem | gb), disk_free_gb: ($free | gb)}' \
    --jsonargs "$cpus" "$load" "$up" "$mem" "$used" "$(df -Pk "$HOME" | awk 'NR == 2 {print $4 * 1024}')"
}

stats() {
  set -e
  local open u d w m host
  open=$(prs --state=open); u=$(usage); d=$(window $DAY); w=$(window $WEEK); m=$(machine); host=$(hostname -s)
  jq -nc --arg host "$host" --argjson open "$open" --argjson u "$u" --argjson d "$d" --argjson w "$w" --argjson m "$m" \
    '{at: (now | todate), host: $host, machine: $m, open_prs: $open, "24h": ($d + $u."24h"), "7d": ($w + $u."7d")}'
}

# PRs opened and merged in the last $1 days, one JSON line {k, u, t} each. GitHub search
# returns at most 1000 results, so ask 10 days at a time (overlapping; the caller dedupes).
day_prs() {
  set -e
  local i a b
  for ((i = $1; i > 0; i -= 10)); do
    a=$(jq -nr --argjson d $((i + 1)) 'now - $d * 86400 | strftime("%Y-%m-%d")')
    b=$(jq -nr --argjson d $((i - 11)) 'now - $d * 86400 | strftime("%Y-%m-%d")')
    gh search prs --author=@me --limit 1000 --created="$a..$b" --json url,createdAt --jq '.[] | {k: "opened", u: .url, t: .createdAt}'
    gh search prs --author=@me --limit 1000 --merged-at="$a..$b" --json url,closedAt --jq '.[] | {k: "merged", u: .url, t: .closedAt}'
  done
}

# One JSON line per local day for the last $1 days, today included, empty days too.
daily() {
  set -e
  local n=$1 t host
  host=$(hostname -s); t=$(mktemp -d); trap "rm -rf '$t'" EXIT
  # Scan a day more than asked: a 25-hour day (DST) starts more than N x 24h ago.
  events $(((n + 1) * DAY)) | jq -Rc "$CALLS" > "$t/calls"
  day_prs "$n" > "$t/prs"
  health_events $(((n + 1) * DAY)) > "$t/health"
  jq -nc --arg host "$host" --arg os "$OS" --argjson n "$n" \
    --slurpfile c "$t/calls" --slurpfile p "$t/prs" --slurpfile h "$t/health" "$STATS$HEALTH"'
    def day: strflocaltime("%Y-%m-%d");
    def count($k): map(select(.k == $k)) | length;
    def files(f): map(select(f) | .f) | unique | length;
    ($c | unique_by(.id) | map(.d = (.ts[:19] + "Z" | fromdate | day)) | group_by(.d) | map({(.[0].d): .}) | add // {}) as $calls |
    ($p | unique_by([.k, .u]) | map(.d = (.t | fromdate | day)) | group_by(.d) | map({(.[0].d): .}) | add // {}) as $prs |
    ($h | map(.d = (.t | day)) | group_by(.d) | map({(.[0].d): .}) | add // {}) as $health |
    # Step back from noon UTC on today'"'"'s date, so a DST change never skips or repeats a day.
    (now | day) as $today | range($n) | (($today + "T12:00:00Z" | fromdate) - . * 86400 | strftime("%Y-%m-%d")) as $d |
    ($calls[$d] // []) as $x | ($prs[$d] // []) as $y |
    {date: $d, host: $host, prs_opened: ($y | count("opened")), prs_merged: ($y | count("merged")),
     claude_sessions: ($x | files(.codex == null and (.f | contains("/subagents/") | not))),
     claude_subagents: ($x | files(.codex == null and (.f | contains("/subagents/")))),
     codex_sessions: ($x | files(.codex != null))} + ($x | stats) + ($health[$d] // [] | health($os))'
}

json=0 with= days=
while [ $# -gt 0 ]; do
  case $1 in
    --json) json=1 ;;
    --with) with=$2; shift ;;
    --days) days=${2-}; shift
      case $days in '' | *[!0-9]* | 0* | ?????*) echo "agent-stats: --days needs a whole number of days, 1 to 9999" >&2; exit 2 ;; esac ;;
    *) echo "usage: agent-stats [--json | --days N] [--with HOST]" >&2; exit 2 ;;
  esac
  shift
done

if [ -n "$days" ]; then mode=(--days "$days"); lines=$(daily "$days"); else mode=(--json); lines=$(stats); fi
if [ -n "$with" ]; then lines+=$'\n'$(ssh -o BatchMode=yes "$with" bash -s -- "${mode[@]}" < "$0"); fi
if [ $json = 1 ] || [ -n "$days" ]; then echo "$lines"; exit 0; fi

jq -rs '
  def h: if . == null then "n/a" elif . >= 1e9 then "\(. / 1e8 | round / 10)B"
    elif . >= 1e6 then "\(. / 1e5 | round / 10)M" elif . >= 1e4 then "\(. / 1e2 | round / 10)k" else tostring end;
  . as $m | (["Last"] + [$m[] | "\(.host) 24h", "\(.host) 7d"] | @tsv),
  ([["PRs opened", "prs_opened"], ["PRs merged", "prs_merged"], ["Claude sessions", "claude_sessions"],
    ["Claude subagents", "claude_subagents"], ["Codex sessions", "codex_sessions"],
    ["Active hours", "active_hours"], ["Agent hours", "agent_hours"], ["Total tokens", "total_tokens"],
    ["Claude output", "output_tokens"], ["Claude input", "input_tokens"], ["Claude cache reads", "cache_read_tokens"],
    ["Codex tokens", "codex_tokens"], ["Crashes", "crashes"], ["OOM kills", "oom_kills"], ["System errors", "system_errors"]][]
    | . as [$label, $k] | [$label] + [$m[] | (."24h"[$k], ."7d"[$k]) | h] | @tsv),
  (["PRs open now"] + [$m[] | (.open_prs | h), "-"] | @tsv)' <<<"$lines" | column -t -s $'\t'
echo
jq -rs '(["Machine", "OS", "Up", "Load", "CPUs", "Memory", "Disk free"] | @tsv),
  (.[] | .machine as $x | [.host, $x.os, "\($x.uptime_hours)h", ($x.load_1m | tostring), ($x.cpus | tostring),
    "\($x.mem_used_gb)/\($x.mem_total_gb) GB", "\($x.disk_free_gb) GB"] | @tsv)' <<<"$lines" | column -t -s $'\t'
